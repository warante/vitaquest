# URL privada de PostgreSQL proporcionada por Railway.
DATABASE_URL=
# UUID del perfil único de la primera instalación.
VITAQUEST_PROFILE_ID=
# Nombre visible en la aplicación.
VITAQUEST_DISPLAY_NAME=David
# Clave privada para entrar en la aplicación. Nunca la subas al repositorio.
VITAQUEST_ACCESS_KEY=

# IA - modelo compatible con OpenAI (endpoint público fijo: https://llm.cerotenedores.com/v1)
# Clave de la API del modelo. Nunca la subas al repositorio.
VITAQUEST_AI_API_KEY=
# Modelo de chat por defecto. Valores disponibles en app/domain/ai-models.ts.
VITAQUEST_AI_MODEL=qwen2.5-coder-32k:latest
